---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPost from '../components/BlogPost.astro';
import Ascii from '../components/Ascii.astro';
import { getCollection } from 'astro:content';

const pageTitle = "Pineappletooth personal space";
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    gap: 2.5rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .split-divider {
    background: var(--border);
  }

  .split-label {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--accent);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.7rem;
  }

  .now-grid {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.3rem 0.7rem;
    font-size: 0.85rem;
  }

  .now-label {
    color: var(--secondary);
  }

  .blog-section {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  ul.post-list {
    list-style: none;
    padding: 0;
  }

  @media (max-width: 560px) {
    .split {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .split-divider {
      display: none;
    }
  }
</style>

<BaseLayout pageTitle={pageTitle}>
  <section class="split">
    <div>
      <p class="split-label">Me</p>
      <p>This is my personal space where i share my thoughts on programming, technology, and other interests.</p>
      <a href="/about/">about me →</a>
    </div>
    <div class="split-divider"></div>
    <div>
      <p class="split-label">Now</p>
      <div class="now-grid">
        <span class="now-label">Playing</span><span>Mewgenics</span>
        <span></span><span>Genshin Impact</span>
        <span class="now-label">Listening</span><span>詩超絆 (Utakotoba) - MyGO!!!!!</span>
        <span></span><span>Connect - Claris</span>
      </div>
    </div>
  </section>

  <section class="blog-section">
    <p class="split-label">Blog</p>
    <ul class="post-list">
      {recentPosts.map((post: any) => (
        <BlogPost
          url={`/blog/${post.id}/`}
          title={post.data.title}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
        />
      ))}
    </ul>
  </section>

  <Ascii />
</BaseLayout>
