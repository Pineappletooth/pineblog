<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-bottom: 1.5rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .site-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--text);
  }

  .site-name:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 1.4rem;
    list-style: none;
    flex-wrap: wrap;
  }

  .nav-links a {
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .nav-links a:hover {
    color: var(--accent);
  }
</style>

<header class="site-header">
  <a href="/" class="site-name">pineappletooth</a>
  <nav class="nav-links">
    <a href="/">home</a>
    <a href="/blog/">blog</a>
    <a href="/about/">about</a>
  </nav>
</header>
