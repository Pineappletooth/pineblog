---
const { url, title, pubDate, tags } = Astro.props;
const dateStr = pubDate ? new Date(pubDate).toISOString().slice(0, 10) : '';
---
<style>
  .post-item {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-date {
    color: var(--muted);
    font-size: 0.8rem;
    display: block;
    margin-bottom: 0.2rem;
  }

  .post-title {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text);
    font-size: 1rem;
    text-decoration: none;
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-tags {
    list-style: none;
    display: inline-flex;
    gap: 0.5rem;
    margin-left: 0.7rem;
  }

  .post-tags a {
    color: var(--secondary);
    font-size: 0.75rem;
    text-decoration: none;
  }

  .post-tags a:hover {
    color: var(--accent);
  }
</style>

<li class="post-item">
  <span class="post-date">{dateStr}</span>
  <a href={url} class="post-title">{title}</a>
  {tags && tags.length > 0 && (
    <ul class="post-tags">
      {tags.map((tag: string) => (
        <li><a href={`/tags/${tag}`}>[{tag}]</a></li>
      ))}
    </ul>
  )}
</li>
